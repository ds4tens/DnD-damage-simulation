{
  "name": "rolldnd",
  "version": "1.0.0",
  "description": "DnD class damage simulation",
  "license": "ISC",
  "author": "d.r.lasuria",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "tsx --test src/**/*.test.ts",
    "start": "tsx src/index.ts",
    "dev": "tsx src/index.ts",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "lint-staged": {
    "src/**/*.ts": "biome check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.7",
    "@types/node": "^20.19.43",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.17.0"
  }
}
